{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "semangkuk-mie-ayam-buffer",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "durable_objects": {
    "bindings": [
      {
        "name": "ANALYTICS_BUFFER",
        "class_name": "AnalyticsBuffer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnalyticsBuffer"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semangkuk-mie-ayam-db",
      "database_id": "621c4563-983a-445e-b73d-3e14d06d8592"
    }
  ],
  "env": {
    "staging": {
      "name": "semangkuk-mie-ayam-buffer-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "ANALYTICS_BUFFER",
            "class_name": "AnalyticsBuffer"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "semangkuk-mie-ayam-db-staging",
          "database_id": "447594e6-c488-4f45-9231-d36fa5b1fe82"
        }
      ]
    }
  }
}
